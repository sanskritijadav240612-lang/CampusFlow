# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/campusflow

# Frontend Client URL
FRONTEND_URL=http://localhost:5173

# JWT Configuration (Minimum 32 characters each)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here

# AI Service Configuration (OpenAI-compatible)
# Optional at startup; required for /api/ai endpoints
AI_API_KEY=your_openai_or_compatible_api_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Campus Timezone for Relative Date/Time Normalization
CAMPUS_TIMEZONE=Asia/Kolkata

# Email Service Configuration (Resend)
# Optional at startup; required for dispatching student notification emails
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=CampusFlow <onboarding@resend.dev>
